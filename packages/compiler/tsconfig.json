{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "paths": {
      "@aeriajs/common": [
        "../common/dist"
      ],
      "@aeriajs/types": [
        "../types/dist"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "@types/*.d.ts",
    "src"
  ]
}
